[~[tlist_sql;
    WITH anchor_enrollment AS (
        SELECT
            pea.studentid,
            pea.grade_level        AS anchor_grade_level,
            pea.yearid             AS anchor_yearid,
            ROW_NUMBER() OVER (
                PARTITION BY pea.studentid
                ORDER BY
                    pea.yearid DESC,
                    pea.exitdate DESC NULLS LAST
            ) AS rn
        FROM
            ps_enrollment_all pea
        WHERE
            pea.studentid = ~(gpv.curstudid)
    ),
    student_anchor AS (
        SELECT
            studentid,
            anchor_grade_level,
            anchor_yearid
        FROM
            anchor_enrollment
        WHERE
            rn = 1
    ),
    grade_year_lookup AS (
        SELECT
            sa.studentid,
            (sa.anchor_yearid - (lvl - 1))               AS yearid,
            (sa.anchor_grade_level - (lvl - 1))          AS derived_grade_level,
            t.firstday,
            t.lastday
        FROM
            student_anchor sa
            CROSS JOIN (
                SELECT level AS lvl
                FROM dual
                CONNECT BY level <= 12
            ) gen
            JOIN terms t
                ON t.schoolid = 0
               AND t.isyearrec = 1
               AND t.yearid = (sa.anchor_yearid - (gen.lvl - 1))
    ), base AS (
        SELECT
            test."NAME"              AS testname,
            test.id                  AS testid,
            test.dcid                AS testdcid,
            testscore.id             AS testscoreid,
            testscore.dcid           AS testscoredcid,
            testscore."NAME"         AS testscorename,
            testscore.description    AS testscoredesc,
    
            studenttest.id           AS studenttestid,
            studenttest.dcid         AS studenttestdcid,
            studenttest.studentid    AS studentid,
            studenttest.test_date    AS test_date,
    
            gyl.yearid               AS yearid,
            gyl.derived_grade_level  AS derived_grade_level,
    
            studenttest.grade_level      AS st_grade_level,
            pea.grade_level              AS pea_grade_level,
            CASE
                WHEN studenttest.grade_level IS NOT NULL
                     AND studenttest.grade_level <> 0
                    THEN studenttest.grade_level
                WHEN pea.grade_level IS NOT NULL
                    THEN pea.grade_level
                ELSE gyl.derived_grade_level
            END AS effective_grade_level,
    
            studenttestscore.numscore,
            studenttestscore.percentscore,
            studenttestscore.alphascore
        FROM
            studenttest studenttest
            JOIN grade_year_lookup gyl
                ON gyl.studentid = studenttest.studentid
               AND studenttest.test_date BETWEEN (gyl.firstday - 15) AND (gyl.lastday + 15)
            LEFT JOIN ps_enrollment_all pea
                ON pea.studentid = studenttest.studentid
               AND studenttest.test_date BETWEEN pea.entrydate AND (pea.exitdate - 1)
            JOIN studenttestscore studenttestscore
                ON studenttestscore.studentid     = studenttest.studentid
               AND studenttestscore.studenttestid = studenttest.id
            JOIN test test
                ON studenttest.testid = test.id
            JOIN testscore testscore
                ON testscore.testid             = test.id
               AND studenttestscore.testscoreid = testscore.id
               AND studenttestscore.studenttestid = studenttest.id
    
        WHERE
            studenttest.studentid = ~(gpv.curstudid)
            AND studenttestscore.numscore != 0
    )
    SELECT
    	base.testname                                   AS testname,
        base.testid                                     AS testid,
        base.testdcid                                   AS testdcid,
        base.testscoreid                                AS testscoreid,
        base.testscoredcid                              AS testscoredcid,
        base.testscorename                              AS testscorename,
        base.testscoredesc                              AS testscoredesc,
    
        base.effective_grade_level                      AS test_grade,
        base.studenttestid                              AS studenttestid,
        base.studenttestdcid                            AS testtestdcid,
        base.studentid                                  AS studentid,
        base.test_date                                  AS test_date,
        base.yearid                                     AS yearid,
    
        lrp_performance_bands.windowname                AS windowname,
    	CASE WHEN u_lrp_testscore_ext.shownum = 1 
            THEN base.numscore
        END                                             AS numscore,
        CASE WHEN u_lrp_testscore_ext.showpercent = 1 
            THEN base.percentscore
        END                                             AS percentscore,
        CASE WHEN u_lrp_testscore_ext.showalpha = 1 
            THEN base.alphascore
        END                                             AS alphascore,
    
        lrp_performance_bands.testbandname,
        lrp_performance_bands.below_benchmark,
        lrp_performance_bands.colorcode,
        below_benchmark_marker.top_band                 AS benchmark_marker,
        lrp_performance_bands.split_at_year
    FROM
        base
        INNER JOIN u_lrp_testscore_ext 
            ON u_lrp_testscore_ext.testscoredcid = base.testscoredcid
           AND ',' || u_lrp_testscore_ext.grade_list || ','
               LIKE '%,' || base.effective_grade_level || ',%'
        LEFT JOIN (
            SELECT
                u_lrp_performance_group.testdcid         AS testdcid,
                u_lrp_performance_bands.testscoredcid    AS testscoredcid,
                u_lrp_performance_bands.grade_level      AS grade_level,
                u_lrp_testband."NAME"                    AS testbandname,
                u_lrp_color_list.colorcode               AS colorcode,
                u_lrp_testwindow.windowname              AS windowname,
                u_lrp_testwindow.window_start            AS window_start,
                u_lrp_testwindow.window_end              AS window_end,
                CASE WHEN TO_DATE(u_lrp_testwindow.window_end, 'MM-DD') >
                          TO_DATE(u_lrp_testwindow.window_start, 'MM-DD')
                     THEN 0 ELSE 1
                END                                      AS crossyear,
                u_lrp_performance_bands.below_benchmark  AS below_benchmark,
                u_lrp_performance_bands.bottom_band      AS bottom_band,
                u_lrp_performance_bands.top_band         AS top_band,
                u_lrp_performance_group.split_at_year    AS split_at_year
            FROM
                u_lrp_performance_group u_lrp_performance_group
                INNER JOIN u_lrp_testband u_lrp_testband 
                    ON u_lrp_testband.groupid = u_lrp_performance_group.id
                   AND u_lrp_testband.bandtype = 'Performance Band'
                INNER JOIN u_lrp_testwindow u_lrp_testwindow
                    ON u_lrp_testwindow.groupid = u_lrp_performance_group.id
                INNER JOIN u_lrp_performance_bands u_lrp_performance_bands
                    ON u_lrp_performance_bands.groupid      = u_lrp_performance_group.id
                   AND u_lrp_performance_bands.testbandid   = u_lrp_testband.id
                   AND u_lrp_performance_bands.testwindowid = u_lrp_testwindow.id
                INNER JOIN u_lrp_color_list u_lrp_color_list
                    ON u_lrp_color_list.id = u_lrp_testband.lrp_color_list_id
            WHERE
                u_lrp_performance_group.isdefault = 1
        ) lrp_performance_bands
            ON lrp_performance_bands.testdcid      = base.testdcid
           AND lrp_performance_bands.testscoredcid = base.testscoredcid
           AND lrp_performance_bands.grade_level   = base.effective_grade_level
           AND (
                (
                    TO_CHAR(base.test_date, 'MM-DD')
                        BETWEEN lrp_performance_bands.window_start
                            AND lrp_performance_bands.window_end
                    AND lrp_performance_bands.crossyear = 0
                    AND NOT (
                        (
                            TO_CHAR(base.test_date, 'MM-DD') BETWEEN lrp_performance_bands.window_start AND '12-30'
                            OR TO_CHAR(base.test_date, 'MM-DD') BETWEEN '01-01' AND lrp_performance_bands.window_end
                        )
                        AND lrp_performance_bands.crossyear = 1
                    )
                )
                OR
                (
                    (
                        TO_CHAR(base.test_date, 'MM-DD') BETWEEN lrp_performance_bands.window_start AND '12-30'
                        OR TO_CHAR(base.test_date, 'MM-DD') BETWEEN '01-01' AND lrp_performance_bands.window_end
                    )
                    AND lrp_performance_bands.crossyear = 1
                    AND NOT (
                        TO_CHAR(base.test_date, 'MM-DD')
                            BETWEEN lrp_performance_bands.window_start
                                AND lrp_performance_bands.window_end
                        AND lrp_performance_bands.crossyear = 0
                    )
                )
            )
           AND (
                ROUND(base.numscore, 0)
                    BETWEEN lrp_performance_bands.bottom_band
                        AND lrp_performance_bands.top_band - 1
                OR (
                    ROUND(base.numscore, 0) = lrp_performance_bands.bottom_band
                    AND ROUND(base.numscore, 0) = lrp_performance_bands.top_band
               )
           )
        LEFT JOIN (
            SELECT
                u_lrp_performance_group.testdcid         AS testdcid,
                u_lrp_performance_bands.testscoredcid    AS testscoredcid,
                u_lrp_performance_bands.grade_level      AS grade_level,
                u_lrp_testband."NAME"                    AS testbandname,
                u_lrp_color_list.colorcode               AS colorcode,
                u_lrp_testwindow.windowname              AS windowname,
                u_lrp_testwindow.window_start            AS window_start,
                u_lrp_testwindow.window_end              AS window_end,
                CASE WHEN TO_DATE(u_lrp_testwindow.window_end, 'MM-DD') >
                          TO_DATE(u_lrp_testwindow.window_start, 'MM-DD')
                     THEN 0 ELSE 1
                END                                      AS crossyear,
                u_lrp_performance_bands.below_benchmark  AS below_benchmark,
                u_lrp_performance_bands.top_band         AS top_band
            FROM
                u_lrp_performance_group u_lrp_performance_group
                INNER JOIN u_lrp_testband u_lrp_testband 
                    ON u_lrp_testband.groupid = u_lrp_performance_group.id
                   AND u_lrp_testband.bandtype != 'Performance Band'
                   AND u_lrp_testband.name = 'Below Benchmark'
                INNER JOIN u_lrp_testwindow u_lrp_testwindow
                    ON u_lrp_testwindow.groupid = u_lrp_performance_group.id
                INNER JOIN u_lrp_performance_bands u_lrp_performance_bands
                    ON u_lrp_performance_bands.groupid      = u_lrp_performance_group.id
                   AND u_lrp_performance_bands.testbandid   = u_lrp_testband.id
                   AND u_lrp_performance_bands.testwindowid = u_lrp_testwindow.id
                INNER JOIN u_lrp_color_list u_lrp_color_list
                    ON u_lrp_color_list.id = u_lrp_testband.lrp_color_list_id
            WHERE
                u_lrp_performance_group.isdefault = 1
        ) below_benchmark_marker
            ON below_benchmark_marker.testdcid      = base.testdcid
           AND below_benchmark_marker.testscoredcid = base.testscoredcid
           AND below_benchmark_marker.grade_level   = base.effective_grade_level
           AND (
                (
                    TO_CHAR(base.test_date, 'MM-DD')
                        BETWEEN below_benchmark_marker.window_start
                            AND below_benchmark_marker.window_end
                    AND below_benchmark_marker.crossyear = 0
                    AND NOT (
                        (
                            TO_CHAR(base.test_date, 'MM-DD') BETWEEN below_benchmark_marker.window_start AND '12-30'
                            OR TO_CHAR(base.test_date, 'MM-DD') BETWEEN '01-01' AND below_benchmark_marker.window_end
                        )
                        AND below_benchmark_marker.crossyear = 1
                    )
                )
                OR
                (
                    (
                        TO_CHAR(base.test_date, 'MM-DD') BETWEEN below_benchmark_marker.window_start AND '12-30'
                        OR TO_CHAR(base.test_date, 'MM-DD') BETWEEN '01-01' AND below_benchmark_marker.window_end
                    )
                    AND below_benchmark_marker.crossyear = 1
                    AND NOT (
                        TO_CHAR(base.test_date, 'MM-DD')
                            BETWEEN below_benchmark_marker.window_start
                                AND below_benchmark_marker.window_end
                        AND below_benchmark_marker.crossyear = 0
                    )
                )
            )
    ORDER BY
        1, 5, 13 DESC
]{
    "testname": "~(testname)",
    "testid": "~(testid)",
    "testdcid": "~(testdcid)",
    "testscoreid": "~(testscoreid)",
    "testscoredcid": "~(testscoredcid)",
    "testscorename": "~(testscorename)",
    "testscoredesc": "~(testscoredesc;json)",
    "test_grade": "~(test_grade)",
    
    "studenttestid": "~(studenttestid)",
    "studenttestdcid": "~(studenttestdcid)",
    "studentid": "~(studentid)",
    "test_date": "~(test_date;d)",
    "yearid": "~(yearid)",
    "windowname": "~(windowname)",
    "numscore": "~(numscore)",
    "percentscore": "~(percentscore)",
    "alphascore": "~(alphascore)",
    "testbandname": "~(testbandname)",
    "below_benchmark": "~(below_benchmark)",
    "colorcode": "~(colorcode)",
    "benchmark": "~(benchmark)",
    "split_at_year": "~(split_at_year)"
},[/tlist_sql]{}]